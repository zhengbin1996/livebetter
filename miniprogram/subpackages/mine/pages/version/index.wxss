.kv {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 4rpx 26rpx;
  margin-bottom: 20rpx;
}
.kvrow {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line2);
}
.kvrow:last-child { border-bottom: none; }
.kvrow .k { font-size: 26rpx; color: var(--ink2); flex: none; }
.kvrow .v {
  font-size: 25rpx;
  color: var(--ink);
  text-align: right;
  word-break: break-all;
}

.btnrow { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 8rpx; }
.btnrow .btn { flex: 1; min-width: 200rpx; }

.dl {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.dl .dl-h {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--ink);
  margin-bottom: 18rpx;
}
.dl .bar { height: 8rpx; border-radius: 4rpx; background: var(--line2); overflow: hidden; }
.dl .bar .fill { height: 100%; background: var(--accent); transition: width .25s ease; }
.dl .dl-p { font-size: 22rpx; margin-top: 14rpx; }

.btnrow button.btn { margin: 0; line-height: 1.5; }
.btnrow button.btn::after { border: 0; }
.btnrow button[disabled] { color: var(--ink3); background: var(--line2); opacity: .7; }
.cache-management { border: 1rpx solid var(--line); border-radius: var(--radius); background: var(--card); margin-top: 24rpx; }
.cache-heading { display: flex; justify-content: space-between; padding: 24rpx 26rpx; font-size: 26rpx; color: var(--ink2); }
.cache-body { border-top: 1rpx solid var(--line2); padding: 24rpx 26rpx; }
.cache-note { font-size: 24rpx; color: var(--ink3); line-height: 1.7; margin-bottom: 20rpx; }
