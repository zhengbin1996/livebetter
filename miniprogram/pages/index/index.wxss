/* 紧凑书名栏：保留识别感，不让欢迎语挡住首屏内容 */
.home-brand {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 0 14rpx;
  border-bottom: 1rpx solid var(--line2);
}
.home-brand-name { min-width: 0; font-size: 30rpx; font-weight: 800; color: var(--ink); }
.home-brand-meta { flex: none; font-size: 20rpx; color: var(--ink3); }

/* 检索输入 */
.searchbar .sinput {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  height: 100%;
}
.searchbar .sph { color: var(--ink3); }

/* ---------- 找问题：按处境分组 ---------- */
.glist {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}
.grow { border-bottom: 1rpx solid var(--line2); }
.grow:last-child { border-bottom: none; }
.ghead {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 24rpx;
}
.ghead .gdot {
  width: 14rpx; height: 14rpx; border-radius: 50%; flex: none;
  background: var(--gray);
}
.ghead .gdot.green { background: var(--green); }
.ghead .gdot.amber { background: var(--amber); }
.ghead .gdot.gray { background: var(--gray); }
.ghead .gname {
  flex: 1;
  font-family: var(--sans);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}
.ghead .gcount { font-size: 22rpx; color: var(--ink3); }
.ghead .gcaret { font-size: 26rpx; color: var(--ink3); width: 26rpx; text-align: right; }

.gbody { padding: 0 0 8rpx; }
.gbody .prow {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 28rpx 20rpx 58rpx;
  border-top: 1rpx solid var(--line2);
}
.gbody .prow .q {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--ink2);
}
.gbody .prow .go {
  flex: none;
  font-size: 22rpx;
  color: var(--ink3);
  padding-top: 6rpx;
}

/* 行卡片 */
.rowcard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
}
.rowcard .rc-l { flex: 1; min-width: 0; }
.rowcard .rc-h {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
}
.rowcard .rc-p {
  font-size: 23rpx;
  color: var(--ink3);
  line-height: 1.6;
  margin-top: 6rpx;
}

.ghead:active, .prow:active, .rowcard:active { background: var(--gray-bg); }
.ghead .gcaret { font-family: var(--sans); font-weight: 700; }
.today-all { min-height: 88rpx; display: flex; align-items: center; font-size: 24rpx; color: var(--accent); font-weight: 700; }
.home-search { padding: 28rpx; margin: 28rpx 0 56rpx; background: var(--gray-bg); border-radius: var(--radius); }
.home-search-title { font-size: 24rpx; font-weight: 700; color: var(--ink2); }
.home-search .searchbar { margin-top: 16rpx; }
.home-module { padding: 28rpx; margin-bottom: 56rpx; border: 1rpx solid var(--line); border-top: 4rpx solid var(--ink); border-radius: var(--radius); background: var(--card); }
.home-module-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 64rpx; margin-bottom: 24rpx; }
.home-module-title { display: flex; align-items: center; gap: 16rpx; min-width: 0; font-size: 32rpx; font-weight: 800; color: var(--ink); line-height: 1.4; }
.home-module-number { flex: none; display: inline-flex; align-items: center; justify-content: center; min-width: 48rpx; height: 48rpx; padding: 0 8rpx; background: var(--action); color: var(--on-action); font-family: var(--mono); font-size: 22rpx; font-weight: 700; }
.home-module-note { margin: -8rpx 0 24rpx; color: var(--ink2); font-size: 24rpx; line-height: 1.7; }
.home-module--recommend { padding-bottom: 12rpx; }
.home-module--recommend .home-module-number { background: var(--highlight); color: var(--on-highlight); }
.home-module--topics { background: var(--gray-bg); }
.home-module--directory { border-top-color: var(--accent); }
.home-module--directory .home-module-number { background: var(--accent-bg); color: var(--accent); }
.home-module .rowcard { border: 0; border-radius: 0; border-bottom: 1rpx solid var(--line2); margin: 0; padding: 24rpx 0; }
.home-module .rowcard:last-child { border-bottom: 0; padding-bottom: 0; }
