.tabbar {
  /* ⚠️ 自定义 tabBar 的节点不挂在 page 下面，**继承不到** app.wxss 里
     `page { --ink3: ... }` 定义的 CSS 变量 —— var() 静默落空，文字掉回默认黑色。
     浅色模式下是「白底黑字」不易察觉；暗色模式下背景被 @media 转暗，
     就成了「暗底黑字」完全看不清（真机实测）。
     所以这里用到的变量必须在组件内自己定义，取值与 app.wxss 保持同步。 */
  --line: #E3E4DF;
  --ink3: #8C918D;
  --green: #2F5D50;
  --mono: "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(251, 251, 249, .94);
  backdrop-filter: blur(12rpx);
  border-top: 1rpx solid var(--line);
  display: flex;
  z-index: 800;
}
@media (prefers-color-scheme: dark) {
  .tabbar {
    --line: #2C3135;
    --ink3: #8F9791;
    --green: #7FBFA6;
    background: rgba(24, 27, 29, .94);
  }
}

.tabbar .tb {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
}

/* 选中标识：一条 4rpx 短横，不是图标 */
.tabbar .mark {
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: transparent;
}
.tabbar .tb.on .mark { background: var(--green); }

.tabbar .lb {
  font-family: var(--mono);
  font-size: 22rpx;
  letter-spacing: .04em;
  color: var(--ink3);
}
.tabbar .tb.on .lb { color: var(--green); }

.tabbar .badge {
  position: absolute;
  top: 18rpx;
  margin-left: 44rpx;
  min-width: 26rpx;
  height: 26rpx;
  padding: 0 8rpx;
  border-radius: 13rpx;
  background: var(--green);
  color: #fff;
  font-family: var(--mono);
  font-size: 18rpx;
  line-height: 26rpx;
  text-align: center;
}
