<view class="page">
  <view class="page-heading">值得再读的建议。</view>
  <view class="collection-count" wx:if="{{count}}">已收藏 {{count}} 条</view>
  <item-row wx:for="{{items}}" wx:key="sid" item="{{item}}" show-sec bindtapitem="goItem" bindretry="onRetry" />
  <view class="empty" wx:if="{{!items.length}}">
    <view class="h">还没有收藏</view>
    <view class="p">看到想留住的建议，点击“收藏”，以后在这里继续阅读。</view>
    <view class="btn btn--primary" bindtap="goSearch">去检索</view>
  </view>
  <view class="disclaimer">收藏保存在本机，联网后同步。</view>
</view>
