.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(251, 251, 249, .94);
  backdrop-filter: blur(12rpx);
  border-top: 1rpx solid var(--line);
  display: flex;
  z-index: 800;
}
@media (prefers-color-scheme: dark) {
  .tabbar { background: rgba(24, 27, 29, .94); }
}

.tabbar .tb {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
}

/* 选中标识：一条 4rpx 短横，不是图标 */
.tabbar .mark {
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: transparent;
}
.tabbar .tb.on .mark { background: var(--green); }

.tabbar .lb {
  font-family: var(--mono);
  font-size: 22rpx;
  letter-spacing: .04em;
  color: var(--ink3);
}
.tabbar .tb.on .lb { color: var(--green); }

.tabbar .badge {
  position: absolute;
  top: 18rpx;
  margin-left: 44rpx;
  min-width: 26rpx;
  height: 26rpx;
  padding: 0 8rpx;
  border-radius: 13rpx;
  background: var(--green);
  color: #fff;
  font-family: var(--mono);
  font-size: 18rpx;
  line-height: 26rpx;
  text-align: center;
}
