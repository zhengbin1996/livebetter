@import "../styles/icons.wxss";

.tabbar {
  --line: #B9B9AF;
  --ink3: #6C6C61;
  --accent: #B3440C;
  --card: #FFFFFF;
  --highlight: #FFDA4B;
  --on-highlight: #25251F;
  --radius: 4rpx;
  --sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: calc(120rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--card);
  border-top: 2rpx solid var(--line);
  display: flex;
  z-index: 800;
}
@media (prefers-color-scheme: dark) {
  .tabbar {
    --line: #77786D;
    --ink3: #ADAEA0;
    --accent: #FFB078;
    --card: #24251F;
    --highlight: #D8B849;
    --on-highlight: #25251F;
  }
}
.tabbar .tb {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  position: relative;
  color: var(--ink3);
}
.tabbar .tb.on { color: var(--accent); }
.tabbar .tb:active { opacity: .72; }
.tabbar .tab-icon { width: 38rpx; height: 38rpx; }
.tabbar .lb { font-family: var(--sans); font-size: 22rpx; font-weight: 600; }
.tabbar .badge {
  position: absolute;
  top: 12rpx;
  margin-left: 48rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border: 1rpx solid var(--on-highlight);
  border-radius: var(--radius);
  background: var(--highlight);
  color: var(--on-highlight);
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: center;
}
