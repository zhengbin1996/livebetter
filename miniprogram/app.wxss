@import "styles/icons.wxss";

page {
  --paper: #FAF9F5;
  --card: #FFFFFF;
  --line: #B9B9AF;
  --line2: #DDDDD4;
  --ink: #25251F;
  --ink2: #55554D;
  --ink3: #6C6C61;
  --accent: #B3440C;
  --accent-bg: #FBE7D8;
  --highlight: #FFDA4B;
  --on-highlight: #25251F;
  --highlight-soft: #FFF3BD;
  --hero-line: #25251F;
  --action: #25251F;
  --on-action: #FFFFFF;
  --green: #2F5D50;
  --green-bg: #EAF0EC;
  --on-green: #FFFFFF;
  --amber: #845910;
  --amber-bg: #F7F0E2;
  --on-amber: #FFFFFF;
  --gray: #606057;
  --gray-bg: #EDEDE7;
  --red: #9C3B2E;
  --red-bg: #F6EAE7;
  --radius: 4rpx;
  --tabbar-h: 120rpx;
  --sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  --mono: "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;

  background: var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

@media (prefers-color-scheme: dark) {
  page {
    --paper: #191A17;
    --card: #24251F;
    --line: #77786D;
    --line2: #44453B;
    --ink: #F7F6EF;
    --ink2: #C7C7BA;
    --ink3: #ADAEA0;
    --accent: #FFB078;
    --accent-bg: #38291D;
    --highlight: #D8B849;
    --on-highlight: #25251F;
    --highlight-soft: #E8CC73;
    --hero-line: #D8B849;
    --action: #F7F6EF;
    --on-action: #25251F;
    --green: #8FC4A8;
    --green-bg: #24382D;
    --on-green: #15271D;
    --amber: #E9BB68;
    --amber-bg: #372E1B;
    --on-amber: #241E10;
    --gray: #C1C1B3;
    --gray-bg: #36372F;
    --red: #F4A28E;
    --red-bg: #35251F;
  }
}

view, text, scroll-view, navigator { box-sizing: border-box; }

.reading-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.reading-heading > view { flex: 1; min-width: 0; }
.reader-share { flex: none; margin: 0; padding: 16rpx 20rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; line-height: 1.5; color: var(--ink2); border: 1rpx solid var(--line); border-radius: var(--radius); background: var(--card); }
.reader-share::after { border: 0; }
.share-cover-canvas { position: fixed; left: -1100px; top: 0; width: 1000px; height: 800px; pointer-events: none; }
.share-mode-note { padding: 24rpx; margin: 24rpx 0; border-left: 4rpx solid var(--accent); background: var(--accent-bg); font-size: 26rpx; line-height: 1.7; color: var(--ink2); }

/* ---------- 排版原子 ---------- */
.serif { font-family: var(--sans); }
.mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
.t1 { color: var(--ink); }
.t2 { color: var(--ink2); }
.t3 { color: var(--ink3); }
.tg { color: var(--accent); }
.ta { color: var(--amber); }
.tr { color: var(--red); }
.f11 { font-size: 22rpx; }
.f12 { font-size: 24rpx; }
.f13 { font-size: 26rpx; }
.f15 { font-size: 30rpx; }

/* ---------- 页面骨架 ---------- */
.page {
  min-height: 100vh;
  padding: 0 40rpx calc(var(--tabbar-h) + 40rpx);
}
.page--flat { padding-bottom: 40rpx; }

.label {
  font-family: var(--sans);
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
  margin: 40rpx 0 20rpx;
}
.label:first-child { margin-top: 28rpx; }

.hr { height: 1rpx; background: var(--line2); }
.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
}

/* ---------- 版本条 ---------- */
.vbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 22rpx 26rpx;
  margin-top: 24rpx;
}
.vbar .l { font-family: var(--mono); font-size: 24rpx; color: var(--ink); }
.vbar .r {
  font-family: var(--mono); font-size: 22rpx; color: var(--ink3);
  text-align: right; line-height: 1.5;
}
.vbar .dot {
  display: inline-block; width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--green); margin-right: 12rpx; vertical-align: 2rpx;
}
.vbar .dot.stale { background: var(--amber); }
.vbar .dot.off { background: var(--ink3); }

/* ---------- 检索入口 ---------- */
.searchbar {
  height: 96rpx;
  background: var(--card);
  border: 2rpx solid var(--ink);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  gap: 16rpx;
  color: var(--ink3);
  font-size: 28rpx;
  margin-top: 24rpx;
}
.searchbar .ic {
  width: 26rpx; height: 26rpx; border: 3rpx solid var(--ink3);
  border-radius: 50%; position: relative; flex: none;
}
.searchbar .ic::after {
  content: ""; position: absolute; right: -10rpx; bottom: -8rpx;
  width: 12rpx; height: 3rpx; background: var(--ink3);
  transform: rotate(45deg);
}

/* ---------- 节列表行 ---------- */
.sectrow {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line2);
}
.sectrow .n {
  font-family: var(--mono); font-size: 23rpx; color: var(--ink3);
  width: 46rpx; flex: none; text-align: right; padding-top: 6rpx;
}
.sectrow .b { flex: 1; min-width: 0; }
.sectrow .b .stt {
  font-family: var(--sans); font-size: 34rpx; font-weight: 700;
  line-height: 1.4; color: var(--ink);
}
.sectrow .b .ssum {
  font-size: 23rpx; color: var(--ink3); margin-top: 8rpx; line-height: 1.55;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.sectrow .m {
  font-family: var(--mono); font-size: 22rpx; color: var(--ink2);
  flex: none; padding-top: 8rpx;
}

/* ---------- 条目标题 ---------- */
.dtitle {
  font-family: var(--sans); font-size: 44rpx; font-weight: 800;
  line-height: 1.4; margin: 12rpx 0 20rpx;
}
.dbread {
  font-family: var(--mono); font-size: 22rpx; color: var(--ink3);
  margin-bottom: 30rpx;
}

.dplain {
  background: var(--highlight);
  border: 2rpx solid var(--hero-line);
  border-radius: var(--radius);
  padding: 30rpx 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 6rpx 6rpx 0 var(--hero-line);
  --ink: var(--on-highlight);
  --ink2: var(--on-highlight);
  --ink3: var(--on-highlight);
}
.dplain .k {
  font-family: var(--mono); font-size: 22rpx; color: var(--on-highlight);
  letter-spacing: .08em; display: block; margin-bottom: 16rpx;
}
.dplain .v {
  font-family: var(--sans); font-size: 32rpx; line-height: 1.85; color: var(--ink);
}

/* 字段块 */
.field { margin-bottom: 38rpx; }
.field .k {
  font-family: var(--mono); font-size: 26rpx; color: var(--ink);
  letter-spacing: .06em; display: block; margin-bottom: 12rpx;
}
.field .v { font-size: 30rpx; line-height: 1.8; color: var(--ink2); }
.field .v .rich { color: var(--ink); }
.field--src .v {
  font-family: var(--mono); font-size: 23rpx; line-height: 1.7;
  word-break: break-all;
}

/* ---------- 按钮 ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 12rpx;
  min-height: 88rpx; padding: 16rpx 28rpx; border-radius: var(--radius);
  border: 1rpx solid var(--line); background: var(--card);
  font-family: var(--sans); font-weight: 700; font-size: 24rpx; color: var(--ink2);
}
.btn--primary { background: var(--action); border-color: var(--action); color: var(--on-action); }
.btn--ghost { background: transparent; }
.btn--block { display: flex; width: 100%; }
.btn--on { border-color: var(--accent); color: var(--accent); background: var(--accent-bg); }

/* ---------- 分段控件 ---------- */
.seg {
  display: flex; border: 1rpx solid var(--line); border-radius: var(--radius);
  overflow: hidden; background: var(--card); margin: 24rpx 0;
}
.seg .s {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  flex: 1; text-align: center; padding: 20rpx 0;
  font-family: var(--mono); font-size: 24rpx; color: var(--ink3);
}
.seg .s.on { background: var(--action); color: var(--on-action); font-weight: 700; }

/* ---------- 标签（筛选片） ---------- */
.chip {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 88rpx; min-width: 88rpx;
  padding: 12rpx 26rpx; margin: 0 16rpx 16rpx 0;
  border: 1rpx solid var(--line); border-radius: var(--radius);
  font-family: var(--mono); font-size: 22rpx; color: var(--ink2);
  background: var(--card);
}
.chip.on { background: var(--action); border-color: var(--action); color: var(--on-action); }

/* ---------- 空态 ---------- */
.empty {
  padding: 120rpx 0; text-align: center;
}
.empty .h {
  font-family: var(--sans); font-size: 30rpx; color: var(--ink2);
  margin-bottom: 14rpx;
}
.empty .p { font-size: 24rpx; color: var(--ink3); line-height: 1.7; }

/* ---------- 免责声明 ---------- */
.disclaimer {
  font-size: 23rpx; color: var(--ink3); line-height: 1.7;
  padding: 28rpx 0 0; border-top: 1rpx solid var(--line2); margin-top: 40rpx;
}

/* ---------- 加载 ---------- */
.loading {
  padding: 80rpx 0; text-align: center;
  font-family: var(--mono); font-size: 23rpx; color: var(--ink3);
}

/* ============================================================
   mp-html 渲染区
   mp-html 的 node 组件开了 addGlobalClass，下面这些规则才穿得进去。
   两处必须补的：
     1) ._table 本身没有 display:table，不补表格会塌成一行；
     2) 引用链接要 dashed 下划线，得压过组件自带的 ._a 颜色。
   选择器都写成 .mp-body xxx（两个类）以保证压过组件内部同名规则。
   ============================================================ */
.mp-body { font-family: var(--sans); }
.mp-body ._p { display: block; margin: 0 0 14rpx; }
.mp-body ._p:last-child { margin-bottom: 0; }

.mp-body ._table {
  display: table;
  width: 100%;
  border-collapse: collapse;
  margin: 20rpx 0;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 23rpx;
}
.mp-body ._thead, .mp-body ._tbody { display: table-row-group; }
.mp-body ._tr { display: table-row; }
.mp-body ._th, .mp-body ._td {
  display: table-cell;
  border: 1rpx solid var(--line);
  padding: 12rpx 14rpx;
  vertical-align: top;
  line-height: 1.6;
  color: var(--ink2);
}
.mp-body ._th { font-weight: 700; background: var(--gray-bg); color: var(--ink); text-align: left; }

.mp-body ._ul, .mp-body ._ol { display: block; padding-left: 34rpx; margin: 14rpx 0; }
.mp-body ._li { display: list-item; margin: 8rpx 0; }

.mp-body ._h1, .mp-body ._h2, .mp-body ._h3, .mp-body ._h4 {
  display: block; font-family: var(--sans); font-weight: 700;
  color: var(--ink); margin: 34rpx 0 14rpx; line-height: 1.45;
}
.mp-body ._h1 { font-size: 40rpx; }
.mp-body ._h2 { font-size: 34rpx; }
.mp-body ._h3 { font-size: 30rpx; }
.mp-body ._h4 { font-size: 28rpx; }

.mp-body ._blockquote {
  display: block;
  border-left: 4rpx solid var(--line);
  padding-left: 20rpx;
  margin: 16rpx 0;
  color: var(--ink2);
}
.mp-body .md-hr { border: none; border-top: 1rpx solid var(--line); margin: 30rpx 0; }

/* 交叉引用：带虚线的指路，点一下跳到那一条 */
.mp-body .ref {
  color: var(--accent);
  border-bottom: 1rpx dashed var(--accent);
  padding-bottom: 1rpx;
}
/* 术语：点一下弹释义 */
.mp-body .gl {
  color: var(--ink);
  border-bottom: 1rpx dashed var(--ink3);
  padding-bottom: 1rpx;
}
/* 来源里的外链：等宽、可换行 */
.mp-body .ext {
  color: var(--ink3);
  font-family: var(--mono);
  font-size: 22rpx;
  word-break: break-all;
}
.mp-body code {
  font-family: var(--mono);
  font-size: 24rpx;
  background: var(--gray-bg);
  padding: 2rpx 8rpx;
  border-radius: var(--radius);
}
.mp-body b { font-weight: 700; }

.page-heading { font-size: 44rpx; font-weight: 800; line-height: 1.4; padding: 32rpx 0 8rpx; }
.dplain { --accent: var(--on-highlight); }
.btn:active, .chip:active, .seg .s:active { opacity: .72; }
