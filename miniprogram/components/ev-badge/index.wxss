.eb {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: var(--radius);
  font-family: var(--mono);
  font-size: 23rpx;
  font-weight: 700;
  flex: none;
}
.eb.is-sm { width: 32rpx; height: 32rpx; border-radius: var(--radius); font-size: 22rpx; }

.eb--A { background: var(--green); color: var(--on-green); }
.eb--B { background: var(--amber); color: var(--on-amber); }
.eb--C { background: var(--gray-bg); color: var(--gray); border: 1rpx solid var(--line); }

.eb--A.is-light { background: var(--green-bg); color: var(--green); }
.eb--B.is-light { background: var(--amber-bg); color: var(--amber); }
.eb--C.is-light { background: var(--gray-bg); color: var(--ink3); }
