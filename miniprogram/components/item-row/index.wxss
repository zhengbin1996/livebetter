.itemrow {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line2);
}
.itemrow .num {
  font-family: var(--mono);
  font-size: 22rpx;
  color: var(--ink3);
  width: 42rpx;
  flex: none;
  text-align: right;
  padding-top: 6rpx;
}
.itemrow .bd { flex: 1; min-width: 0; }

.itemrow .ttl-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 14rpx;
}
.itemrow .ttl-line .h {
  font-family: var(--serif);
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}
.itemrow .star { color: var(--green); font-size: 24rpx; flex: none; }

.itemrow .tagline { margin-bottom: 12rpx; }
.itemrow .flag {
  font-family: var(--mono);
  font-size: 19rpx;
  color: var(--red);
  background: var(--red-bg);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.itemrow .plain {
  font-size: 24rpx;
  color: var(--ink2);
  line-height: 1.7;
  margin-bottom: 18rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.itemrow .meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}
.itemrow .meta .mt {
  font-family: var(--mono);
  font-size: 21rpx;
  color: var(--ink3);
}
