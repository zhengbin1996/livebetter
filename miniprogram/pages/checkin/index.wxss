.seg--sub { margin-top: -8rpx; }

.prog {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 8rpx;
}
.prog .pg-h {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.prog .pg-n { font-family: var(--serif); font-size: 40rpx; font-weight: 600; color: var(--ink); }
.prog .pg-p { font-size: 26rpx; color: var(--green); }
.prog .bar { height: 8rpx; border-radius: 4rpx; background: var(--line2); overflow: hidden; }
.prog .bar .fill { height: 100%; background: var(--green); transition: width .25s ease; }
.prog .pg-note {
  font-size: 23rpx;
  color: var(--ink3);
  line-height: 1.7;
  margin-top: 20rpx;
}

.clist {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  overflow: hidden;
}
.clist .crow {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 24rpx 26rpx 26rpx;
  border-bottom: 1rpx solid var(--line2);
}
.clist .crow:last-child { border-bottom: none; }
.clist .cr-main { flex: 1; min-width: 0; }
.clist .cr-h {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}
.clist .cr-sec { font-size: 20rpx; color: var(--ink3); }
.clist .cr-done {
  font-size: 18rpx;
  color: var(--green);
  background: var(--green-bg);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.clist .cr-t {
  font-family: var(--serif);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}
.clist .cr-t.is-done { color: var(--ink3); text-decoration: line-through; }
.clist .cr-p {
  font-size: 23rpx;
  color: var(--ink3);
  line-height: 1.65;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.clist .cr-acts {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding-left: 20rpx;
}
.clist .cr-a {
  font-size: 28rpx;
  color: var(--ink3);
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
}
.clist .cr-a.on { color: var(--green); border-color: var(--green); background: var(--green-bg); }

.btnrow { display: flex; gap: 20rpx; justify-content: center; margin-top: 40rpx; }
