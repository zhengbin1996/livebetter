<!-- 条目卡片。列表页（分节目录、检索、收藏）共用。
     左上是条号，标题用宋体，说人话做两行摘要，底部是成本签与两个正交标注。 -->
<view class="itemrow" bindtap="onTap">
  <text class="num">{{num}}</text>
  <view class="bd">
    <view class="ttl-line">
      <text class="h" wx:if="{{showSec}}">{{secTag}}·</text>
      <text class="h">{{item.title}}</text>
      <text class="star" wx:if="{{fav}}">★</text>
    </view>

    <view class="tagline" wx:if="{{disputed}}">
      <text class="flag">争议</text>
    </view>

    <view class="plain" wx:if="{{item.preview}}">{{item.preview}}</view>

    <cost-tag tag="{{item.tag}}" label-map="{{labelMap}}" size="sm" />

    <view class="meta">
      <ev-badge level="{{item.evidenceLevel}}" light sm />
      <tier-meter level="{{item.ratio}}" sm />
      <text class="mt">性价比 {{item.ratio}}</text>
    </view>
  </view>
</view>
