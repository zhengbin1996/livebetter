.advice-card { padding: 28rpx; margin-bottom: 20rpx; border: 1rpx solid var(--line); border-radius: var(--radius); background: var(--card); }
.advice-card--highlight { background: var(--highlight); border: 2rpx solid var(--hero-line); box-shadow: 6rpx 6rpx 0 var(--hero-line); --ink: var(--on-highlight); --ink2: var(--on-highlight); --ink3: var(--on-highlight); --line: var(--hero-line); --action: #25251F; --on-action: #FFFFFF; --green: #2F5D50; --green-bg: #EAF0EC; }
.advice-meta { color: var(--ink3); font-size: 22rpx; line-height: 1.5; margin-bottom: 10rpx; }
.advice-title { color: var(--ink); font-family: var(--sans); font-size: 34rpx; font-weight: 800; line-height: 1.5; overflow-wrap: break-word; }
.advice-summary { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: var(--ink2); font-size: 28rpx; line-height: 1.75; margin-top: 14rpx; white-space: pre-line; overflow-wrap: break-word; }
.advice-main { margin-bottom: 24rpx; }
.advice-main:active { opacity: .75; }
.advice-favorite { display: inline-flex; align-items: center; min-height: 88rpx; padding: 0 24rpx; background: transparent; color: var(--ink2); font-size: 24rpx; border: 1rpx solid var(--line); border-radius: var(--radius); }
.advice-favorite:active { opacity: .75; }
.advice-flags { display: flex; gap: 12rpx; margin-top: 12rpx; font-size: 22rpx; color: var(--red); }
.advice-flags text { background: var(--red-bg); padding: 4rpx 12rpx; }
.advice-unavailable { display: flex; align-items: center; justify-content: space-between; color: var(--ink3); font-size: 24rpx; margin-bottom: 16rpx; }
.advice-unavailable view { min-height: 88rpx; display: flex; align-items: center; color: var(--accent); font-weight: 700; padding: 0 20rpx; }
