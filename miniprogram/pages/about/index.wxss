.masthead { padding: 32rpx 0 20rpx; }
.masthead .bk { font-family: var(--sans); font-size: 46rpx; font-weight: 700; line-height: 1.3; }
.masthead .sub { font-size: 24rpx; color: var(--ink2); line-height: 1.7; margin-top: 12rpx; }
.rowcard { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; background: var(--card); border: 1rpx solid var(--line); border-radius: var(--radius); padding: 26rpx 28rpx; margin-bottom: 16rpx; }
.rowcard .rc-l { flex: 1; min-width: 0; }
.rowcard .rc-h { font-family: var(--sans); font-size: 30rpx; font-weight: 700; line-height: 1.45; color: var(--ink); }
.rowcard .rc-p { font-size: 23rpx; color: var(--ink3); line-height: 1.6; margin-top: 6rpx; }
.about-group { border: 1rpx solid var(--line); border-radius: var(--radius); background: var(--card); padding: 0 26rpx; }
.about-group .rowcard { border: 0; border-bottom: 1rpx solid var(--line2); border-radius: 0; padding: 26rpx 0; margin: 0; }
.about-group .rowcard:last-child { border-bottom: 0; }
.helpbox, .sourcebox { background: var(--card); border: 1rpx solid var(--line); border-radius: var(--radius); padding: 8rpx 26rpx; margin-bottom: 16rpx; }
.help-row { padding: 20rpx 0; border-bottom: 1rpx solid var(--line2); }
.help-row:last-child { border-bottom: 0; }
.help-head, .source-title { font-size: 27rpx; font-weight: 700; color: var(--ink); margin-bottom: 8rpx; }
.help-body, .source-text { display: block; font-size: 25rpx; color: var(--ink2); line-height: 1.75; }
.sourcebox { padding: 28rpx 26rpx; margin-bottom: 32rpx; }
.source-text { margin-bottom: 16rpx; }
.source-text:last-child { margin-bottom: 0; }
.source-title--spaced { padding-top: 24rpx; margin-top: 24rpx; border-top: 1rpx solid var(--line2); }
.source-link { font-size: 25rpx; color: var(--accent); margin-top: 20rpx; }
.source-url { display: block; font-size: 22rpx; color: var(--ink3); line-height: 1.7; margin-top: 6rpx; word-break: break-all; }
