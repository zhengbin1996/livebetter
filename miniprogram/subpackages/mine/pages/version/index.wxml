<view class="page page--flat">
  <view class="label">内容与更新</view>
  <view class="kv">
    <view class="kvrow"><text class="k">内容日期</text><text class="v mono">{{contentDate}}</text></view>
    <view class="kvrow"><text class="k">最近检查</text><text class="v mono">{{checkedText}}</text></view>
  </view>
  <view class="btnrow">
    <button class="btn btn--primary" disabled="{{busy || downBusy}}" bindtap="onSync">{{busy ? '正在检查…' : '检查更新'}}</button>
  </view>

  <view class="label">离线内容</view>
  <view class="kv">
    <view class="kvrow"><text class="k">缓存状态</text><text class="v">{{cache.complete ? '全书已缓存' : (cache.files ? '部分内容已缓存' : '尚未缓存正文')}}</text></view>
    <view class="kvrow"><text class="k">已下载</text><text class="v mono">{{cacheText}}</text></view>
  </view>
  <view class="dl" wx:if="{{downBusy}}">
    <view class="dl-h mono"><text>下载中 · {{progress.text}}</text><text>{{progress.percent}}%</text></view>
    <view class="bar"><view class="fill" style="width:{{progress.percent}}%"></view></view>
    <view class="dl-p mono t3">{{progress.size}}</view>
  </view>
  <view class="btnrow">
    <button class="btn" disabled="{{downBusy || busy}}" bindtap="onDownload">{{downBusy ? '正在下载…' : '下载全书'}}</button>
  </view>
  <view class="disclaimer">全书下载包含章节正文和长文。已缓存的内容可离线阅读，下载中断后可继续；完整检索需要联网，离线时只能搜本机缓存。检查到新内容后，可再次下载以供离线阅读。</view>

  <view class="cache-management">
    <view class="cache-heading" bindtap="toggleCacheManagement">
      <text>缓存管理</text><text class="mono t3">{{cacheManagementOpen ? '收起' : '展开'}}</text>
    </view>
    <view class="cache-body" wx:if="{{cacheManagementOpen}}">
      <view class="cache-note">清理正文缓存不会删除收藏。{{downBusy ? '下载中暂时不能清理缓存。' : ''}}</view>
      <view class="btnrow">
        <button class="btn" disabled="{{downBusy || busy}}" bindtap="onPrune">清理旧版本</button>
        <button class="btn" disabled="{{downBusy || busy}}" bindtap="onClear">清空正文缓存</button>
      </view>
    </view>
  </view>
</view>
