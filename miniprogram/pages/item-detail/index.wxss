/* 详情页留出底部操作条的空间 */
.page { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }

.flags { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.flags .flag {
  font-family: var(--mono);
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}
.flags .flag--r { color: var(--red); background: var(--red-bg); }
.flags .flag--a { color: var(--amber); background: var(--amber-bg); }

/* 两个正交标注并排 */
.marks {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 0 40rpx;
}
.marks .mk {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
}
.marks .mk .mk-b { flex: 1; min-width: 0; }
.marks .mk .mk-k {
  display: block;
  font-size: 19rpx;
  color: var(--ink3);
  letter-spacing: .04em;
}
.marks .mk .mk-v {
  display: block;
  font-size: 21rpx;
  color: var(--ink2);
  line-height: 1.5;
  margin-top: 4rpx;
}

.field .k .copy {
  color: var(--green);
  margin-left: 12rpx;
}
.field + .field { margin-top: 0; }
.field .v { font-family: var(--serif); }

/* 交叉引用列表 */
.reflist {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.reflist .refrow {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid var(--line2);
}
.reflist .refrow:last-child { border-bottom: none; }
.reflist .rr { flex: none; font-size: 21rpx; color: var(--green); }
.reflist .rt {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.5;
}

/* 成本签（说人话与等级标记之间） */
.costwrap { margin-bottom: 4rpx; }

/* 底部操作条 */
.actbar {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  background: rgba(251, 251, 249, .96);
  backdrop-filter: blur(12rpx);
  border-top: 1rpx solid var(--line);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  z-index: 700;
}
@media (prefers-color-scheme: dark) {
  .actbar { background: rgba(24, 27, 29, .96); }
}
.actbar .act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 84rpx;
}
/* 每个屏幕只允许一个主按钮 */
.actbar .act--primary {
  background: var(--green-bg);
  border-radius: 12rpx;
}
.actbar .act--primary .ai,
.actbar .act--primary .at { color: var(--green); }
.actbar .act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 84rpx;
}
.actbar .ai { font-size: 32rpx; color: var(--ink3); }
.actbar .ai.on { color: var(--green); }
.actbar .at {
  font-family: var(--mono);
  font-size: 24rpx;
  color: var(--ink3);
}
.actbar .at.on { color: var(--green); }
