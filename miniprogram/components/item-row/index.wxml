<view class="advice-card {{highlight ? 'advice-card--highlight' : ''}}">
  <view class="advice-main" bindtap="onTap" aria-role="button" aria-label="{{normalized.title || '查看建议'}}">
    <view class="advice-meta">
      <text wx:if="{{showSec && normalized.sec}}">{{normalized.sec}} 节 · </text>
      <text wx:if="{{normalized.num}}">第 {{normalized.num}} 条</text>
    </view>
    <view class="advice-title">{{normalized.title || '正文未下载'}}</view>
    <view class="advice-flags" wx:if="{{normalized.dispute || normalized.todo}}">
      <text wx:if="{{normalized.dispute}}">争议</text><text wx:if="{{normalized.todo}}">待核实</text>
    </view>
    <view class="advice-summary" wx:if="{{normalized.summary}}">{{normalized.summary}}</view>
  </view>
  <view class="advice-unavailable" wx:if="{{normalized.unavailable}}">
    <text>正文未下载</text><view bindtap="onRetry" aria-role="button">重试</view>
  </view>
  <view class="advice-favorite" bindtap="onFavorite" aria-role="button" aria-label="{{saved ? '取消收藏' : '收藏'}}">{{saved ? '已收藏 · 取消' : '收藏'}}</view>
</view>
