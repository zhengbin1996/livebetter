.pack-page { padding-bottom: calc(var(--tabbar-h) + 40rpx + env(safe-area-inset-bottom)); }
.pack-hero { padding: 36rpx 28rpx; background: var(--card); border: 1rpx solid var(--line); border-top: 6rpx solid var(--accent); margin-top: 24rpx; }
.pack-kicker { display: block; color: var(--accent); font-size: 23rpx; font-weight: 700; margin-bottom: 16rpx; }
.pack-title { font-size: 48rpx; font-weight: 700; line-height: 1.3; margin-bottom: 20rpx; }
.pack-description { display: block; color: var(--ink2); font-size: 25rpx; line-height: 1.8; }
.pack-description--spaced { margin-top: 22rpx; }
.pack-price { display: flex; align-items: baseline; gap: 20rpx; padding: 28rpx 0 16rpx; }
.pack-amount { font-size: 56rpx; font-weight: 700; color: var(--accent); }
.pack-price-note, .pack-date { font-size: 23rpx; color: var(--ink3); }
.pack-card { padding: 26rpx; border: 1rpx solid var(--line); background: var(--card); margin-bottom: 20rpx; }
.pack-card-title { font-size: 30rpx; font-weight: 700; line-height: 1.6; margin-bottom: 16rpx; }
.pack-topics { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.pack-topics text { font-size: 23rpx; padding: 8rpx 12rpx; border: 1rpx solid var(--line2); color: var(--ink2); }
.pack-button { min-height: 88rpx; padding: 22rpx; font-size: 27rpx; line-height: 1.6; border: 1rpx solid var(--ink); border-radius: 2rpx; background: var(--action); color: var(--on-action); margin: 26rpx 0; }
.pack-button::after { border: 0; }
.pack-button[disabled] { background: var(--line2); color: var(--ink3); border-color: var(--line); }
.pack-source { display: block; color: var(--ink3); font-size: 22rpx; line-height: 1.8; }
.pack-test { margin-top: 28rpx; padding: 28rpx; border: 1rpx solid var(--accent); background: var(--card); }
.pack-test .pack-button { margin: 20rpx 0 16rpx; }
.pack-test-note { display: block; line-height: 1.8; }
