<view class="page">
  <view class="share-mode-note" wx:if="{{singlePage}}">朋友圈预览 · 点击下方“前往小程序”，搜索与阅读全文。</view>
  <view class="home-brand">
    <text class="home-brand-name">{{bookName}}</text>
    <text class="home-brand-meta mono">{{counts.sections}} 节 · {{counts.items}} 条 · 原文阅读</text>
  </view>

  <!-- 检索入口 -->
  <view class="home-search">
  <view class="home-search-title">找一条需要的建议</view>
  <view class="searchbar">
    <view class="ic"></view>
    <input
      class="sinput"
      value="{{q}}"
      placeholder="搜建议、搜症状、搜钱的事"
      placeholder-class="sph"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
  </view>
  </view>

  <view class="home-module home-module--recommend" wx:if="{{pick}}">
  <view class="home-module-head">
    <view class="home-module-title"><text class="home-module-number">01</text><text>推荐阅读</text></view>
    <view class="today-all" bindtap="onPickShuffle" aria-role="button">换一条 ↻</view>
  </view>
  <item-row item="{{pick}}" highlight show-sec bindtapitem="onAdviceOpen" bindretry="onAdviceRetry" />
  </view>

  <!-- 找问题：按处境分五组，先扫 5 个组名，再展开到具体问题 -->
  <view class="home-module home-module--topics">
  <view class="home-module-head"><view class="home-module-title"><text class="home-module-number">02</text><text>按你的处境</text></view></view>
  <view class="home-module-note">从关心的问题开始，展开分类找建议。</view>
  <view class="glist">
    <view class="grow" wx:for="{{groups}}" wx:for-item="g" wx:key="key">
      <view class="ghead" data-key="{{g.key}}" bindtap="toggleGroup">
        <text class="gdot {{g.tone}}"></text>
        <text class="gname">{{g.name}}</text>
        <text class="gcount mono">{{g.count}}</text>
        <text class="gcaret mono">{{g.open ? '−' : '+'}}</text>
      </view>
      <view class="gbody" wx:if="{{g.open}}">
        <view
          class="prow"
          wx:for="{{g.problems}}"
          wx:for-item="p"
          wx:key="q"
          data-sec="{{p.sec}}"
          bindtap="onProblem"
        >
          <text class="q">{{p.q}}</text>
          <text class="go mono">{{p.sec}} 节 ›</text>
        </view>
      </view>
    </view>
  </view>
  </view>

  <!-- 按节读：老用户的路径保留，只是降到次一级 -->
  <view class="home-module home-module--directory">
  <view class="home-module-head"><view class="home-module-title"><text class="home-module-number">03</text><text>全书目录</text></view></view>
  <view class="rowcard" bindtap="goSections">
    <view class="rc-l">
      <view class="rc-h serif">章节与专题长文</view>
      <view class="rc-p">{{counts.sections}} 节 · {{counts.docs}} 篇专题，按需要查阅</view>
    </view>
    <text class="mono t3">{{counts.items}} 条 ›</text>
  </view>
  </view>

  <view class="disclaimer">{{disclaimer}}</view>
</view>
