/* 分段控件上的计数 */
.seg .s { display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.seg .s .sn { font-family: var(--mono); font-size: 20rpx; color: var(--ink3); }
.seg .s.on .sn { color: var(--green); }

/* 节奏卡：连续天数 + 今天进度 */
.board {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
}
.board .bd-l { flex: none; min-width: 132rpx; text-align: center; }
.board .bd-n {
  font-family: var(--serif);
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.1;
  color: var(--green);
}
.board .bd-k { font-size: 20rpx; color: var(--ink3); margin-top: 6rpx; }
.board .bd-r {
  flex: 1;
  min-width: 0;
  border-left: 1rpx solid var(--line2);
  padding-left: 28rpx;
}
.board .bd-t { font-size: 26rpx; color: var(--ink); line-height: 1.5; }
.board .bd-p { font-size: 22rpx; color: var(--ink3); line-height: 1.65; margin-top: 8rpx; }

.clist {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  overflow: hidden;
}
.clist .crow {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 20rpx 26rpx 26rpx;
  border-bottom: 1rpx solid var(--line2);
}
.clist .crow:last-child { border-bottom: none; }
.clist .cr-main { flex: 1; min-width: 0; }
.clist .cr-h {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}
.clist .cr-sec { font-size: 20rpx; color: var(--ink3); }
.clist .cr-tag {
  font-size: 18rpx;
  color: var(--ink3);
  background: var(--gray-bg);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.clist .cr-tag--g { color: var(--green); background: var(--green-bg); }
.clist .cr-t {
  font-family: var(--serif);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}
.clist .cr-t.is-done { color: var(--ink3); text-decoration: line-through; }
.clist .cr-p {
  font-size: 23rpx;
  color: var(--ink3);
  line-height: 1.65;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.clist .cr-acts {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding-left: 18rpx;
}
.clist .cr-a {
  font-size: 26rpx;
  color: var(--ink3);
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
}
.clist .cr-a.on { color: var(--green); border-color: var(--green); background: var(--green-bg); }

.morewrap { margin-top: 22rpx; }

.btnrow { display: flex; gap: 20rpx; justify-content: center; margin-top: 40rpx; }
