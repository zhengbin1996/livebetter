/* 离线状态条：常驻首屏顶部，三态用语义色点表示；下载中态换行出一条细进度条 */
.ostrip {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
}
.ostrip .odot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--ink3); flex: none;
}
.ostrip .odot.g { background: var(--green); }
.ostrip .odot.a { background: var(--amber); }
.ostrip .ostrip-t { flex: 1; font-size: 23rpx; color: var(--ink2); }
.ostrip .ostrip-a { font-size: 22rpx; color: var(--green); flex: none; }
/* 下载中态的就地进度条（宽 100% 借 flex-wrap 换到第二行） */
.ostrip .obar {
  flex-basis: 100%;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--line2);
  overflow: hidden;
}
.ostrip .obar .ofill {
  height: 100%;
  background: var(--green);
  transition: width .25s ease;
}

/* 书封区 */
.masthead { padding: 32rpx 0 8rpx; }
.masthead .bk {
  font-family: var(--serif);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: .01em;
  color: var(--ink);
}
.masthead .tag {
  font-size: 25rpx;
  color: var(--ink2);
  line-height: 1.75;
  margin-top: 14rpx;
}
.masthead .stats {
  font-size: 21rpx;
  color: var(--ink3);
  margin-top: 18rpx;
  letter-spacing: .01em;
}

/* ---------- 今天做一条（首屏主角） ---------- */
.pick {
  margin-top: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-left: 6rpx solid var(--green);
  border-radius: 8rpx 20rpx 20rpx 8rpx;
  padding: 28rpx 30rpx 24rpx;
}
.pick .pick-h {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.pick .pick-k {
  font-size: 21rpx;
  color: var(--green);
  letter-spacing: .08em;
}
.pick .pick-src { font-size: 19rpx; color: var(--ink3); }
.pick .pick-t {
  font-family: var(--serif);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--ink);
}
.pick .pick-p {
  font-size: 26rpx;
  color: var(--ink2);
  line-height: 1.7;
  margin-top: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
.pick .pick-cost { margin-top: 22rpx; }
.pick .pick-acts {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.pick .pick-acts .btn { flex: 1; }

/* 检索输入 */
.searchbar .sinput {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  height: 100%;
}
.searchbar .sph { color: var(--ink3); }

/* ---------- 找问题：按处境分组 ---------- */
.glist {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  overflow: hidden;
}
.grow { border-bottom: 1rpx solid var(--line2); }
.grow:last-child { border-bottom: none; }
.ghead {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 28rpx;
}
.ghead .gdot {
  width: 14rpx; height: 14rpx; border-radius: 50%; flex: none;
  background: var(--gray);
}
.ghead .gdot.green { background: var(--green); }
.ghead .gdot.amber { background: var(--amber); }
.ghead .gdot.gray { background: var(--gray); }
.ghead .gname {
  flex: 1;
  font-family: var(--serif);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.ghead .gcount { font-size: 21rpx; color: var(--ink3); }
.ghead .gcaret { font-size: 26rpx; color: var(--ink3); width: 26rpx; text-align: right; }

.gbody { padding: 0 0 8rpx; }
.gbody .prow {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 28rpx 20rpx 58rpx;
  border-top: 1rpx solid var(--line2);
}
.gbody .prow .q {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--ink2);
}
.gbody .prow .go {
  flex: none;
  font-size: 21rpx;
  color: var(--ink3);
  padding-top: 6rpx;
}

/* 行卡片 */
.rowcard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
}
.rowcard .rc-l { flex: 1; min-width: 0; }
.rowcard .rc-h {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}
.rowcard .rc-p {
  font-size: 23rpx;
  color: var(--ink3);
  line-height: 1.6;
  margin-top: 6rpx;
}

/* 下载中：进度显示已并入顶部状态条（.obar/.ofill），底部只留一张只读卡片 */
