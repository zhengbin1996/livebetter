<view class="share-mode-note" wx:if="{{singlePage}}">朋友圈预览 · 点击下方“前往小程序”，阅读全文与收藏。</view>
<view class="loading" wx:if="{{loading}}">正在取这条…</view>

<!-- 内容对不上：与「没存到本机」分开写，出路也不同（前者去检索，后者去下载） -->
<view class="empty" wx:elif="{{notFound}}">
  <view class="h serif">这条内容对不上</view>
  <view class="p">内容更新后，这条建议可能改了标题。可以按关键词重新搜索，或返回上一页。</view>
  <view class="btn btn--primary" style="margin-top:36rpx" bindtap="onSearch">去检索</view>
</view>

<view class="empty" wx:elif="{{offline && !item}}">
  <view class="h serif">这条还没存到本机</view>
  <view class="p">{{singlePage ? '请点击微信底部“前往小程序”，继续读取原文。' : '联网后重试，也可到「关于 → 离线与更新」下载全书。'}}</view>
  <view class="btn btn--primary" wx:if="{{!singlePage}}" style="margin-top:36rpx" bindtap="onRetry">重试</view>
</view>

<block wx:else>
  <view class="page page--flat">
    <!-- 跨版本兜底：按内置索引落到同一条的位置，如实告诉用户 -->
    <view class="stalenote" wx:if="{{stale}}">
      内容已更新，这条是按最新版里的同一条打开的
    </view>

    <view class="dbread" bindtap="goSection">{{crumb}} ›</view>

    <view class="dtitle">{{item.title || '正文未下载'}}</view>

    <view class="stalenote" wx:if="{{offline}}">
      {{plainHtml ? '已显示本机摘要，原文未下载' : '正文未下载'}}
      <text class="copy" bindtap="onRetry"> · 重试</text>
    </view>

    <view class="flags" wx:if="{{item.dispute || item.todo}}">
      <text class="flag flag--r" wx:if="{{item.dispute}}">争议</text>
      <text class="flag flag--a" wx:if="{{item.todo}}">待核实</text>
    </view>

    <!-- 说人话：全站唯一一处左侧强调边，视觉最高位。
         提到标题正下方 —— 用户打开一条建议，第一眼要看的是「结论是什么」，
         而不是成本签和等级标记。 -->
    <view class="dplain" wx:if="{{plainHtml}}">
      <text class="k">原文摘要</text>
      <view class="v">
        <mp-html
          class="mp-body"
          content="{{plainHtml}}"
          copy-link="{{false}}"
          bindlinktap="onLinkTap"
        />
      </view>
    </view>

    <!-- 成本签：五格等宽表 -->
    <view wx:if="{{originalAvailable}}" id="original-toggle" class="original-toggle" bindtap="toggleOriginal" aria-role="button">{{originalOpen ? '收起原文 ↑' : '查看原文 ↓'}}</view>
    <block wx:if="{{originalAvailable && originalOpen}}">
    <view class="costwrap">
      <cost-tag
        tag="{{item.tag}}"
        label-map="{{labelMap}}"
        tappable="{{true}}"
        bindcelltap="onCellTap"
      />
    </view>

    <!-- 证据等级 + 性价比，两个正交标注并排 -->
    <view class="marks">
      <view class="mk">
        <ev-badge level="{{item.evidenceLevel}}" />
        <view class="mk-b">
          <text class="mk-k mono">证据等级</text>
          <text class="mk-v">{{evidenceText}}</text>
        </view>
      </view>
      <view class="mk">
        <tier-meter level="{{item.ratio}}" sm show-text="{{false}}" />
        <view class="mk-b">
          <text class="mk-k mono">性价比</text>
          <text class="mk-v">{{item.ratio}} · 作者判断，非证据</text>
        </view>
      </view>
    </view>

    <view class="field">
      <text class="k">收益</text>
      <view class="v">
        <mp-html class="mp-body" content="{{benefitHtml}}" copy-link="{{false}}" bindlinktap="onLinkTap" />
      </view>
    </view>

    <view class="field">
      <text class="k">成本</text>
      <view class="v">
        <mp-html class="mp-body" content="{{costHtml}}" copy-link="{{false}}" bindlinktap="onLinkTap" />
      </view>
    </view>

    <view class="field" wx:if="{{noteHtml}}">
      <text class="k">备注</text>
      <view class="v">
        <mp-html class="mp-body" content="{{noteHtml}}" copy-link="{{false}}" bindlinktap="onLinkTap" />
      </view>
    </view>

    <view class="field field--src">
      <text class="k">来源 <text class="copy" bindtap="onCopySource">复制</text></text>
      <view class="v">
        <mp-html class="mp-body" content="{{sourceHtml}}" copy-link="{{false}}" bindlinktap="onLinkTap" />
      </view>
    </view>

    <!-- 理解辅助：指出去哪儿、谁指过来 -->
    <view class="label" wx:if="{{refsOut.length}}">这条还提到</view>
    <view class="reflist" wx:if="{{refsOut.length}}">
      <view class="refrow" wx:for="{{refsOut}}" wx:for-item="r" wx:key="toSid" data-sid="{{r.toSid}}" bindtap="goRef">
        <text class="rr mono">{{r.toSec}} 节 · 第 {{r.toNum}} 条</text>
        <text class="rt serif">{{r.targetTitle || r.label}}</text>
      </view>
    </view>

    <view class="label" wx:if="{{refsIn.length}}">有 {{refsIn.length}} 条建议指向这里</view>
    <view class="reflist" wx:if="{{refsIn.length}}">
      <view class="refrow" wx:for="{{refsIn}}" wx:for-item="r" wx:key="sid" data-sec="{{r.sec}}" bindtap="goSec">
        <text class="rr mono">{{r.sec}} 节 · 第 {{r.num}} 条</text>
        <text class="rt mono">翻过去 ›</text>
      </view>
    </view>

    <view class="original-toggle" bindtap="toggleOriginal" aria-role="button">收起原文 ↑</view>
    </block>
    <view class="disclaimer">
      {{disclaimer}}
    </view>
  </view>

  <view class="actbar" wx:if="{{!singlePage}}">
    <view class="act" bindtap="onFav" aria-role="button" aria-label="{{fav ? '取消收藏' : '收藏这条建议'}}">
      <view class="ai icon icon--star {{fav ? 'on' : ''}}"></view>
      <text class="at {{fav ? 'on' : ''}}">{{fav ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="act reader-share" wx:if="{{shareable}}" open-type="share">分享给好友 ↗</button>
  </view>

  <gloss-pop show="{{glossShow}}" term="{{glossaryTerm}}" bind:close="onGlossClose" />
</block>
<canvas wx:if="{{!singlePage}}" type="2d" id="share-cover-canvas" class="share-cover-canvas" aria-hidden="true" />
