.searchbox { display: flex; align-items: center; gap: 20rpx; }
.searchbox .searchbar { flex: 1; }
.searchbox .clr { font-size: 22rpx; color: var(--ink3); flex: none; }
.searchbar .sinput { flex: 1; font-size: 28rpx; color: var(--ink); height: 100%; }
.searchbar .sph { color: var(--ink3); }
.searchbar .go {
  font-family: var(--mono);
  font-size: 24rpx;
  color: var(--accent);
  padding-left: 12rpx;
  flex: none;
}

.sealed { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.sealed .sd {
  font-size: 22rpx;
  color: var(--ink3);
  background: var(--gray-bg);
  border-radius: var(--radius);
  padding: 6rpx 18rpx;
}

.filterbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0 20rpx;
}
.filterbar .fb-k { font-size: 22rpx; color: var(--ink3); letter-spacing: .06em; }
.filterbar .fb-v {
  font-family: var(--mono);
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent-bg);
  border-radius: var(--radius);
  padding: 3rpx 12rpx;
}
.filterbar .fb-x {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--accent);
}

.filters {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 20rpx 24rpx 24rpx;
  margin-bottom: 24rpx;
}
.filters .fg { padding: 16rpx 0; border-bottom: 1rpx solid var(--line2); }
.filters .fg:last-of-type { border-bottom: none; }
.filters .fg-k {
  display: block;
  font-size: 22rpx;
  color: var(--ink3);
  letter-spacing: .06em;
  margin-bottom: 12rpx;
}
.filters .fg-opts { display: flex; flex-wrap: wrap; }
.filters .chip { margin-bottom: 10rpx; }

.statusline {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 20rpx 0 12rpx;
  font-size: 22rpx;
  color: var(--ink2);
}

/* 结果 */
.results .hit {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line2);
}
.results .hit-h {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}
.results .hit-sec { font-size: 22rpx; color: var(--ink3); }
/* 长文 / 核实记录：加一条中性色条，和 675 条建议一眼区分开。
   用 --ink3 而不是彩色 —— 长文不承载证据等级，不该借用证据色。 */
.results .hit--doc { border-left: 3rpx solid var(--ink3); padding-left: 20rpx; }
.results .hit--doc .hit-sec { color: var(--ink2); letter-spacing: 1rpx; }
.results .hit-flag {
  font-size: 22rpx;
  color: var(--red);
  background: var(--red-bg);
  border-radius: var(--radius);
  padding: 2rpx 10rpx;
}
.results .hit-t {
  font-family: var(--sans);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
}
.results .hit-s {
  font-size: 24rpx;
  color: var(--ink2);
  line-height: 1.7;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.results .hit-m {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
}
/* 命中高亮：用绿底而非荧光黄，和全站语义色一致 */
.hl {
  color: var(--on-highlight);
  background: var(--highlight);
  border-radius: 4rpx;
  padding: 0 2rpx;
}

.morehint {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink3);
  padding: 30rpx 0;
}

.results .hit:active { background: var(--gray-bg); }
.searchbox .clr, .filterbar .fb-x, .searchbar .go { min-height: 88rpx; display: flex; align-items: center; }
.filter-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1100; background: rgba(0,0,0,.5); display: flex; align-items: flex-end; }
.filter-sheet { width: 100%; max-height: 88vh; display: flex; flex-direction: column; background: var(--paper); border-top: 2rpx solid var(--ink); padding-bottom: env(safe-area-inset-bottom); }
.filter-head { padding: 20rpx 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; font-size: 32rpx; font-weight: 800; border-bottom: 1rpx solid var(--line); }
.filter-close { min-height: 88rpx; display: flex; align-items: center; font-size: 24rpx; color: var(--ink2); }
.filter-scroll { height: 58vh; box-sizing: border-box; padding: 24rpx 28rpx; }
.filter-scroll .fg { padding-bottom: 24rpx; }
.filter-scroll .fg-k { display: block; font-size: 24rpx; color: var(--ink2); margin-bottom: 16rpx; }
.filter-scroll .fg-opts { display: flex; flex-wrap: wrap; }
.filter-footer { display: flex; gap: 20rpx; padding: 20rpx 28rpx; border-top: 1rpx solid var(--line); }
.filter-footer .btn { flex: 1; }
.filterbar .fb-v { min-height: 88rpx; display: flex; align-items: center; padding: 0 18rpx; }
.sealed .sd { min-height: 88rpx; display: flex; align-items: center; }
.doc-open { min-height: 88rpx; display: flex; align-items: center; color: var(--accent); font-size: 24rpx; font-weight: 700; }
