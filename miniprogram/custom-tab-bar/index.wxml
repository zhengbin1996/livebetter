<view class="tabbar">
  <view
    class="tb {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="path"
    data-i="{{index}}"
    bindtap="onTap"
  >
    <view class="icon tab-icon icon--{{item.icon}}"></view>
    <text class="lb">{{item.text}}</text>
    <text class="badge" wx:if="{{item.badge}}">{{item.badge}}</text>
  </view>
</view>
